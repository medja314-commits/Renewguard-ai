<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>
<StackPane xmlns:fx="http://javafx.com/fxml/1"
fx:controller="fr.renewguard.controller.EquipmentController"
style="-fx-background-color: #0A0E14;">
<VBox spacing="0" StackPane.alignment="TOP_LEFT">
<HBox alignment="CENTER_LEFT" spacing="16" style="-fx-padding: 24 24 20 24;">
<VBox spacing="3" HBox.hgrow="ALWAYS">
<Label text="Equipements" style="-fx-font-family: 'Inter'; -fx-font-size: 22px; -fx-font-weight: 700; -fx-text-fill: #F5F7FA;"/>
<Label fx:id="equipmentCountLabel" text="12 equipements enregistres" style="-fx-font-family: 'Inter'; -fx-font-size: 12px; -fx-text-fill: #8B93A7;"/>
</VBox>
<Button fx:id="addEquipmentBtn" text="+ Ajouter" onAction="#onAddEquipment" style="-fx-background-color: linear-gradient(to bottom right, #22D3A5, #1BB88E); -fx-background-radius: 10; -fx-border-color: transparent; -fx-text-fill: #0A0E14; -fx-font-family: 'Inter'; -fx-font-size: 13px; -fx-font-weight: 700; -fx-cursor: hand; -fx-padding: 8 18 8 18; -fx-effect: dropshadow(gaussian, rgba(34,211,165,0.28), 10, 0, 0, 2);"/>
</HBox>
<HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 0 24 18 24;">
<HBox alignment="CENTER_LEFT" spacing="0" HBox.hgrow="ALWAYS" style="-fx-background-color: rgba(255,255,255,0.04); -fx-border-color: #2A3342; -fx-border-radius: 10; -fx-background-radius: 10; -fx-border-width: 1; -fx-max-width: 320;">
<SVGPath content="M21,21 L15,15 M17,11 A6,6 0 1 1 5,11 A6,6 0 1 1 17,11" strokeWidth="1.6" stroke="#4A5568" fill="transparent" strokeLineCap="ROUND" style="-fx-padding: 0 10 0 12;"/>
<TextField fx:id="searchField" promptText="Rechercher un equipement…" HBox.hgrow="ALWAYS" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-font-family: 'Inter'; -fx-font-size: 13px; -fx-text-fill: #F5F7FA; -fx-prompt-text-fill: #4A5568; -fx-padding: 9 12 9 8;"/>
</HBox>
<Button fx:id="filterAll" text="Tous" onAction="#onFilter" styleClass="chip-active" userData="all"/>
<Button fx:id="filterCritique" text="Critique" onAction="#onFilter" styleClass="chip-critical" userData="critical"/>
<Button fx:id="filterActif" text="Actif" onAction="#onFilter" styleClass="chip" userData="active"/>
<Button fx:id="filterInactif" text="Inactif" onAction="#onFilter" styleClass="chip" userData="inactive"/>
<Region HBox.hgrow="ALWAYS"/>
<Button fx:id="exportBtn" text="Exporter" onAction="#onExport" style="-fx-background-color: transparent; -fx-border-color: #2A3342; -fx-border-radius: 8; -fx-background-radius: 8; -fx-border-width: 1; -fx-text-fill: #8B93A7; -fx-font-family: 'Inter'; -fx-font-size: 12px; -fx-cursor: hand; -fx-padding: 6 14 6 14;"/>
</HBox>
<StackPane VBox.vgrow="ALWAYS" style="-fx-padding: 0 24 24 24;">
<TableView fx:id="equipmentTable" styleClass="table-view" style="-fx-background-color: rgba(15,20,32,0.75); -fx-border-color: #2A3342; -fx-border-radius: 16; -fx-background-radius: 16; -fx-border-width: 1;">
<columns>
<TableColumn fx:id="colNom" text="Equipement" prefWidth="220"/>
<TableColumn fx:id="colEmplacement" text="Emplacement" prefWidth="160"/>
<TableColumn fx:id="colPuissance" text="Puissance" prefWidth="100"/>
<TableColumn fx:id="colPriorite" text="Priorite" prefWidth="120"/>
<TableColumn fx:id="colStatut" text="Statut" prefWidth="110"/>
<TableColumn fx:id="colActions" text="" prefWidth="80"/>
</columns>
<placeholder><Label text="" style="-fx-text-fill: transparent;"/></placeholder>
</TableView>
<StackPane fx:id="tableEmptyStateSlot" visible="false" managed="false" StackPane.alignment="CENTER"/>
</StackPane>
</VBox>
<StackPane fx:id="dialogOverlay" visible="false" managed="false" StackPane.alignment="CENTER" style="-fx-background-color: rgba(0,0,0,0.55);"/>
</StackPane>
