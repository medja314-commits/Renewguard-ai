<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<StackPane xmlns:fx="http://javafx.com/fxml/1"
fx:controller="fr.renewguard.component.ExportDialogController"
style="-fx-background-color: rgba(0,0,0,0.55);">
<VBox fx:id="dialogRoot" maxWidth="450.0" spacing="0" style="-fx-background-color: rgba(15,20,32,0.97); -fx-border-color: #2A3342; -fx-border-radius: 18; -fx-background-radius: 18; -fx-border-width: 1; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.70), 48, 0, 0, 8); -fx-padding: 32;">
<Label text="Exporter les equipements" style="-fx-font-family: 'Inter'; -fx-font-size: 16px; -fx-font-weight: 700; -fx-text-fill: #F5F7FA; -fx-padding: 0 0 6 0;"/>
<Label text="Selectionnez le format et la periode d'export." wrapText="true" style="-fx-font-family: 'Inter'; -fx-font-size: 12px; -fx-text-fill: #8B93A7; -fx-padding: 0 0 24 0;"/>
<Separator style="-fx-opacity: 0.25; -fx-padding: 0 0 24 0;"/>
<VBox spacing="4" style="-fx-padding: 24 0 14 0;">
<Label text="Format d'export" style="-fx-font-family: 'Inter'; -fx-font-size: 12px; -fx-font-weight: 500; -fx-text-fill: #8B93A7;"/>
<ComboBox fx:id="formatCombo" maxWidth="Infinity" promptText="Choisir un format…" style="-fx-background-color: rgba(255,255,255,0.04); -fx-border-color: #2A3342; -fx-border-radius: 10; -fx-background-radius: 10; -fx-border-width: 1; -fx-font-family: 'Inter'; -fx-font-size: 13px; -fx-text-fill: #F5F7FA; -fx-prompt-text-fill: #4A5568; -fx-padding: 0 0 0 4; -fx-pref-height: 42;"/>
<Label fx:id="formatError" text="" visible="false" managed="false" style="-fx-font-family: 'Inter'; -fx-font-size: 11px; -fx-text-fill: #FF4D4D;"/>
</VBox>
<VBox spacing="4" style="-fx-padding: 0 0 28 0;">
<Label text="Periode" style="-fx-font-family: 'Inter'; -fx-font-size: 12px; -fx-font-weight: 500; -fx-text-fill: #8B93A7;"/>
<ComboBox fx:id="periodCombo" maxWidth="Infinity" promptText="Choisir une periode…" style="-fx-background-color: rgba(255,255,255,0.04); -fx-border-color: #2A3342; -fx-border-radius: 10; -fx-background-radius: 10; -fx-border-width: 1; -fx-font-family: 'Inter'; -fx-font-size: 13px; -fx-text-fill: #F5F7FA; -fx-prompt-text-fill: #4A5568; -fx-padding: 0 0 0 4; -fx-pref-height: 42;"/>
<Label fx:id="periodError" text="" visible="false" managed="false" style="-fx-font-family: 'Inter'; -fx-font-size: 11px; -fx-text-fill: #FF4D4D;"/>
</VBox>
<HBox spacing="12" style="-fx-padding: 0 0 28 0;">
<Button fx:id="cancelBtn" text="Annuler" onAction="#onCancel" style="-fx-background-color: transparent; -fx-border-color: #2A3342; -fx-border-radius: 10; -fx-background-radius: 10; -fx-border-width: 1; -fx-text-fill: #8B93A7; -fx-font-family: 'Inter'; -fx-font-size: 13px; -fx-font-weight: 500; -fx-cursor: hand; -fx-padding: 9 20 9 20;"/>
<Region HBox.hgrow="ALWAYS"/>
<Button fx:id="exportBtn" text="Exporter" defaultButton="true" onAction="#onExport" style="-fx-background-color: linear-gradient(to bottom right, #22D3A5, #1BB88E); -fx-background-radius: 10; -fx-border-color: transparent; -fx-text-fill: #0A0E14; -fx-font-family: 'Inter'; -fx-font-size: 13px; -fx-font-weight: 700; -fx-cursor: hand; -fx-padding: 9 22 9 22; -fx-effect: dropshadow(gaussian, rgba(34,211,165,0.28), 10, 0, 0, 2);"/>
</HBox>
</VBox>
</StackPane>
