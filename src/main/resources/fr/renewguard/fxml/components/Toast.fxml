<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<HBox xmlns:fx="http://javafx.com/fxml/1"
fx:id="toastRoot"
fx:controller="fr.renewguard.component.ToastController"
alignment="CENTER_LEFT"
spacing="10"
style="-fx-background-color: rgba(21,27,38,0.95);
-fx-border-color: transparent transparent transparent #22D3A5;
-fx-border-width: 0 0 0 3;
-fx-border-radius: 10;
-fx-background-radius: 10;
-fx-pref-height: 44;
-fx-padding: 0 18 0 14;
-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.55), 20, 0, 0, 4);">
<Label fx:id="toastIcon" text="✓" style="-fx-font-size: 14px; -fx-font-weight: 700; -fx-text-fill: #22D3A5;"/>
<Label fx:id="toastMessage" text="Regle creee avec succes" style="-fx-font-family: 'Inter'; -fx-font-size: 13px; -fx-font-weight: 500; -fx-text-fill: #F5F7FA;"/>
</HBox>
