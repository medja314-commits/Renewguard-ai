<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<StackPane xmlns:fx="http://javafx.com/fxml/1"
fx:controller="fr.renewguard.component.ConfirmActionDialogController"
style="-fx-background-color: rgba(0,0,0,0.55);">
<VBox fx:id="dialogRoot" maxWidth="380.0" spacing="0" style="-fx-background-color: rgba(13,18,30,0.97); -fx-border-color: #2A3342; -fx-border-radius: 16; -fx-background-radius: 16; -fx-border-width: 1; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.72), 48, 0, 0, 8); -fx-padding: 28;">
<Label fx:id="titleLabel" text="Confirmer l'action" style="-fx-font-family: 'Inter'; -fx-font-size: 15px; -fx-font-weight: 700; -fx-text-fill: #F5F7FA; -fx-padding: 0 0 10 0;"/>
<Label fx:id="messageLabel" text="Cette action coupera l'equipement immediatement." wrapText="true" style="-fx-font-family: 'Inter'; -fx-font-size: 13px; -fx-text-fill: #8B93A7; -fx-line-spacing: 3; -fx-padding: 0 0 26 0;"/>
<HBox spacing="10" alignment="CENTER_RIGHT">
<Button fx:id="cancelBtn" text="Annuler" onAction="#onCancel" style="-fx-background-color: transparent; -fx-border-color: #2A3342; -fx-border-radius: 10; -fx-background-radius: 10; -fx-border-width: 1; -fx-text-fill: #8B93A7; -fx-font-family: 'Inter'; -fx-font-size: 13px; -fx-font-weight: 500; -fx-cursor: hand; -fx-padding: 9 20 9 20;"/>
<Button fx:id="confirmBtn" text="Confirmer" defaultButton="true" onAction="#onConfirm" style="-fx-background-color: linear-gradient(to bottom right, #22D3A5, #1BB88E); -fx-background-radius: 10; -fx-border-color: transparent; -fx-text-fill: #0A0E14; -fx-font-family: 'Inter'; -fx-font-size: 13px; -fx-font-weight: 700; -fx-cursor: hand; -fx-padding: 9 22 9 22; -fx-effect: dropshadow(gaussian, rgba(34,211,165,0.28), 10, 0, 0, 2);"/>
</HBox>
</VBox>
</StackPane>
